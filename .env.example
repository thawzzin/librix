# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/librix

# Optional: set to "require" when your host requires SSL
PGSSLMODE=disable

# Optional server-only override for a Gutendex mirror or self-hosted instance.
GUTENDEX_API_URL=https://gutendex.com

# Use a separate disposable database for integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/librix_test
